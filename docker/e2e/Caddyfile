:80 {
	# API calls -> backend
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Config service -> backend
	handle /config_service {
		reverse_proxy backend:8080
	}

	# Health check -> backend
	handle /health {
		reverse_proxy backend:8080
	}

	# Swagger -> backend
	handle /swagger/* {
		reverse_proxy backend:8080
	}

	# Everything else -> frontend
	handle {
		reverse_proxy frontend:80
	}
}
